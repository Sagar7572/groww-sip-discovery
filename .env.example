# Copy this file to ".env" and fill in your own keys.
# Never share the .env file or paste these keys into any chat.

# YouTube Data API (free) - Google Cloud Console > APIs & Services > Credentials
YOUTUBE_API_KEY=

# Reddit API (free, only if your access request is approved)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=groww-sip-research/0.1 (academic project)

# AI models (free tiers) - used later in the pipeline, not for collection
GROQ_API_KEY=
GEMINI_API_KEY=
